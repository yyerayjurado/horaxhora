{% extends 'layout/base.html.twig' %}

{% block title %}Iniciar sesión | {{ app_nombre }}{% endblock %}

{% block content %}
    <div class="auth-contenedor">
        <div class="auth">
            {# * POST a /login: lo procesa AuthController::login() #}
            <form action="/login" method="POST" class="auth__form">
                <h1 class="auth__titulo">Iniciar sesión</h1>
                <p class="auth__subtitulo">Entra para gestionar tus ofertas, tu agenda y tus puntos.</p>

                <div class="auth__campo">
                    <label for="email" class="auth__label">Email</label>
                    <input type="email" id="email" name="email" class="auth__input"
                           placeholder="Email" autocomplete="email" required>
                </div>

                <div class="auth__campo">
                    <label for="password" class="auth__label">Contraseña</label>
                    <input type="password" id="password" name="password" class="auth__input"
                           placeholder="Contraseña" autocomplete="current-password" required>
                </div>

                {# * Solo aparece si el controlador manda un error #}
                {% if error %}
                    <p class="auth__error">{{ error }}</p>
                {% endif %}

                <button type="submit" class="auth__boton">Entrar</button>

                <p class="auth__pie">¿No tienes cuenta? <a href="/registro">Regístrate y recibe 50 puntos</a></p>
            </form>
        </div>
    </div>
{% endblock %}
