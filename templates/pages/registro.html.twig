    <link rel="stylesheet" href="/assets/css/registro.css">
{% endblock %}

{% block content %}
    <div class="auth-contenedor">
        <div class="auth auth--registro">
            {# ! El formulario está en partials/form-registro.html.twig, NO borrar este archivo #}
