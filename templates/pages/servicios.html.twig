{% extends 'layout/base.html.twig' %}

{% block title %}Servicios | {{ app_nombre }}{% endblock %}

{% block content %}
    {# * Cabecera con el buscador #}
    <section class="buscador">
        <h1 class="buscador__titulo">Encuentra a quien te ayude</h1>
        <p class="buscador__texto">Busca entre los servicios que ofrece la comunidad y págalos con tus puntos.</p>

        {# * buscador.js escucha estos campos y vuelve a pedir los resultados al cambiar #}
        <form id="form-buscador" class="buscador__form" role="search">
            <label for="busqueda" class="buscador__label">Buscar servicio</label>
            <input type="search" id="busqueda" name="busqueda" class="buscador__input"
                   placeholder="¿Qué necesitas? Ej: clases de inglés, fontanería..." autocomplete="off">

            <label for="orden" class="buscador__label">Ordenar por</label>
            <select id="orden" name="orden" class="buscador__select">
                <option value="valoracion">Mejor valorados</option>
                <option value="precio_asc">Menos puntos</option>
                <option value="precio_desc">Más puntos</option>
            </select>
        </form>

        {# * Filtro por categoría. "" = todas #}
        {# TODO: pasar "categorias" desde el controlador con el DAO y quitar el default #}
        <div class="filtros" id="filtros-categoria" role="group" aria-label="Filtrar por categoría">
            <button type="button" class="filtro is-active" data-categoria="">Todas</button>
            {% for categoria in categorias|default([
                {id_categoria: 1, nombre: 'Hogar y reparaciones'},
                {id_categoria: 2, nombre: 'Clases y formación'},
                {id_categoria: 3, nombre: 'Informática'},
                {id_categoria: 4, nombre: 'Electricidad'}
            ]) %}
                <button type="button" class="filtro" data-categoria="{{ categoria.id_categoria }}">
                    {{ categoria.nombre }}
                </button>
            {% endfor %}
        </div>
    </section>

    {# * Resultados: los rellena buscador.js #}
    {# ? data-usuario: el id del usuario conectado, para no dejarle solicitar sus propias ofertas #}
    <section class="resultados" aria-live="polite" data-usuario="{{ usuario ? usuario.id : '' }}">
        <p class="resultados__contador" id="resultados-contador"></p>

        <ul class="resultados__grid" id="resultados-lista"></ul>

        {# * Se enseña cuando no hay ninguna oferta con esos filtros #}
        <div class="resultados__vacio" id="resultados-vacio" hidden>
            <h2>No hay resultados</h2>
            <p>Prueba con otra búsqueda o con otra categoría.</p>
        </div>
    </section>

    {# * Molde de una tarjeta. No se ve: buscador.js lo copia y rellena una por oferta #}
    <template id="plantilla-oferta">
        <li class="oferta">
            <div class="oferta__cabecera">
                <span class="oferta__categoria"></span>
                <span class="oferta__puntos"></span>
            </div>

            <h3 class="oferta__servicio"></h3>
            <p class="oferta__descripcion"></p>

            <div class="oferta__pie">
                <a class="oferta__profesional" href="#">
                    <span class="oferta__avatar"></span>
                    <span>
                        <span class="oferta__nombre"></span>
                        <span class="oferta__valoracion"></span>
                    </span>
                </a>

                {# ! Solo puede solicitar quien ha iniciado sesión #}
                {% if usuario %}
                    <button type="button" class="btn btn--primario oferta__boton">Solicitar</button>
                {% else %}
                    <a href="/login" class="btn btn--secundario oferta__boton">Entra para solicitar</a>
                {% endif %}
            </div>
        </li>
    </template>

    {# * Molde del formulario de solicitud. buscador.js lo mete dentro del modal al pulsar "Solicitar" #}
    <template id="plantilla-solicitud">
        <form class="modal-form solicitud" id="form-solicitud" novalidate>
            {# * Resumen de lo que va a pedir #}
            <div class="solicitud__resumen">
                <p class="solicitud__servicio"></p>
                <p class="solicitud__profesional"></p>
            </div>

            <p class="modal-form__error" id="solicitud-error" hidden></p>

            <label for="solicitud-fecha">Día</label>
            <input type="date" id="solicitud-fecha" name="fecha" required>

            <label for="solicitud-hora">Hora</label>
            <input type="time" id="solicitud-hora" name="hora" value="10:00" step="900" required>

            <label for="solicitud-horas">Horas que necesitas</label>
            <input type="number" id="solicitud-horas" name="horas" value="1" min="0.5" max="8" step="0.5" required>

            {# * Lo calcula buscador.js al cambiar las horas. El precio de verdad lo calcula el servidor #}
            <p class="solicitud__total">Total: <strong id="solicitud-total"></strong></p>
            <p class="modal-form__nota">Los puntos no se descuentan ahora: solo cuando los dos confirméis que el servicio está hecho.</p>

            <button type="submit" class="btn btn--primario">Enviar solicitud</button>
        </form>
    </template>
{% endblock %}

{% block scripts %}
    <script src="/assets/js/modules/buscador.js" defer></script>
{% endblock %}
