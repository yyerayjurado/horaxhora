{% extends 'layout/base.html.twig' %}

{% block title %}Mi agenda | {{ app_nombre }}{% endblock %}

{% block styles %}
    {# ? admin.css tiene las cajas, mensajes e insignias; agenda.css las tarjetas de la agenda #}
    <link rel="stylesheet" href="/assets/css/admin.css">
    <link rel="stylesheet" href="/assets/css/agenda.css">
{% endblock %}

{% block content %}
    <div class="admin">
        <h1 class="admin__titulo">Mi agenda</h1>
        <p class="agenda__intro">Aquí tienes los servicios que te piden y los que has pedido tú.</p>

        {# * Mensaje verde (acción hecha) o rojo (error). Lo enseña agenda.js #}
        <p class="admin__mensaje" id="agenda-mensaje" hidden></p>

        {# * ===== 1. Solicitudes que me han hecho y tengo que contestar ===== #}
        <section class="agenda__seccion">
            <h2 class="agenda__subtitulo">
                Te toca responder
                <span class="agenda__contador" id="contador-responder">0</span>
            </h2>
            <div id="lista-responder"></div>
            <p class="agenda__vacio" id="vacio-responder" hidden>No tienes solicitudes por responder.</p>
        </section>

        {# * ===== 2. Trueques que todavía no han terminado ===== #}
        <section class="agenda__seccion">
            <h2 class="agenda__subtitulo">
                Próximos y en curso
                <span class="agenda__contador" id="contador-proximos">0</span>
            </h2>
            <div id="lista-proximos"></div>
            <p class="agenda__vacio" id="vacio-proximos" hidden>
                No tienes trueques en marcha. <a href="/servicios">Busca un servicio</a>
            </p>
        </section>

        {# * ===== 3. Historial: completados, rechazados y cancelados (plegado) ===== #}
        <details class="agenda__seccion agenda__historial">
            <summary class="agenda__subtitulo">
                Historial
                <span class="agenda__contador" id="contador-historial">0</span>
            </summary>
            <div id="lista-historial"></div>
            <p class="agenda__vacio" id="vacio-historial" hidden>Todavía no tienes trueques terminados.</p>
        </details>
    </div>

    {# * Molde de una tarjeta. agenda.js lo copia y lo rellena con cada trueque #}
    <template id="plantilla-tarjeta">
        <article class="tarjeta">
            {# * Fecha grande a la izquierda, como una hoja de calendario #}
            <div class="tarjeta__fecha">
                <span class="tarjeta__dia"></span>
                <span class="tarjeta__mes"></span>
            </div>

            <div class="tarjeta__cuerpo">
                <p class="tarjeta__etiquetas">
                    <span class="tarjeta__rol"></span>
                    <span class="admin__insignia"></span>
                </p>
                <h3 class="tarjeta__titulo"></h3>
                <p class="tarjeta__info"></p>

                {# * Frase que explica en qué punto está y qué hay que hacer #}
                <p class="tarjeta__estado"></p>

                {# * Valoración ya hecha (solo en trueques completados) #}
                <p class="tarjeta__valoracion" hidden></p>

                {# * Formulario para valorar (solo el cliente, en trueques completados) #}
                <form class="tarjeta__valorar" hidden>
                    <label>
                        Puntuación
                        <select name="puntuacion" required>
                            <option value="5">★★★★★ Excelente</option>
                            <option value="4">★★★★☆ Muy bien</option>
                            <option value="3">★★★☆☆ Bien</option>
                            <option value="2">★★☆☆☆ Regular</option>
                            <option value="1">★☆☆☆☆ Mal</option>
                        </select>
                    </label>
                    <label>
                        Comentario (opcional)
                        <textarea name="comentario" rows="2" maxlength="500"
                                  placeholder="¿Qué tal ha ido el servicio?"></textarea>
                    </label>
                    <button type="submit" class="btn btn--primario">Enviar valoración</button>
                </form>

                <p class="tarjeta__error" hidden></p>
            </div>

            {# * Puntos y botones a la derecha #}
            <div class="tarjeta__lado">
                <span class="tarjeta__puntos"></span>
                <div class="tarjeta__botones"></div>
            </div>
        </article>
    </template>
{% endblock %}

{% block scripts %}
    <script src="/assets/js/modules/agenda.js" defer></script>
{% endblock %}
