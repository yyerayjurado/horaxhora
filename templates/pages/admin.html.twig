{% extends 'layout/base.html.twig' %}

{% block title %}Panel de administración | {{ app_nombre }}{% endblock %}

{% block content %}
    <div class="admin">
        <h1 class="admin__titulo">Panel de administración</h1>

        {# * Pestañas: cada una es un enlace normal a /admin/{seccion} #}
        <nav class="admin__pestanas" aria-label="Secciones del panel">
            {% set pestanas = {
                categorias: 'Categorías',
                servicios: 'Servicios',
                usuarios: 'Usuarios',
                trueques: 'Trueques',
                resenas: 'Reseñas'
            } %}

            {% for clave, texto in pestanas %}
                <a href="/admin/{{ clave }}" class="admin__pestana {{ seccion == clave ? 'is-active' }}"
                   {% if seccion == clave %}aria-current="page"{% endif %}>
                    {{ texto }}
                    {# ! Contador rojo de registros pendientes (lo calcula PHP en cada carga) #}
                    {% if clave == 'usuarios' and pendientes > 0 %}
                        <span class="admin__badge" aria-label="{{ pendientes }} registros pendientes">{{ pendientes }}</span>
                    {% endif %}
                </a>
            {% endfor %}
        </nav>

        <section class="admin__contenido">
            {# * Mensaje de la última acción (verde si va bien, rojo si hay error) #}
            {% if mensaje %}
                <p class="admin__mensaje {{ mensaje.error ? 'admin__mensaje--error' }}" role="status">{{ mensaje.texto }}</p>
            {% endif %}

            {# * Cada sección está en su propio archivo: partials/admin/categorias.html.twig, etc. #}
            {% include 'partials/admin/' ~ seccion ~ '.html.twig' %}
        </section>
    </div>
{% endblock %}
